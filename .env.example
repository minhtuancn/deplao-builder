# ─── Deplao Web Server Configuration ───

# Web server port
WEB_PORT=8080

# ─── PostgreSQL (required for multi-user auth) ───
POSTGRES_URL=postgresql://deplao:deplao_secret@localhost:5432/deplao

# ─── JWT Secret (change in production!) ───
JWT_SECRET=your-super-secret-key-change-me

# ─── AES encryption key (change in production!) ───
# Used by PlatformConfig to encrypt cookies, API keys, credentials
SERVER_SECRET=your-super-secret-aes-key-change-me-plz

# ─── Data directories (optional, default: ~/.deplao) ───
DEPLAO_DATA_DIR=
DEPLAO_CACHE_DIR=

# ─── PostgreSQL connection pool ───
PG_POOL_MIN=2
PG_POOL_MAX=10

# ─── Telegram API credentials (from my.telegram.org) ───
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=

# ─── Logging ───
LOG_LEVEL=info

# ─── CORS origin (comma-separated) ───
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
