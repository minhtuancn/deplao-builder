# ─── Deplao Web Server Configuration ───

# Web server mode
WEB_ENABLED=1
WEB_PORT=8080

# ─── PostgreSQL (required for multi-user auth) ───
POSTGRES_URL=postgresql://deplao:deplao_secret@localhost:5432/deplao

# ─── JWT Secret (change in production!) ───
JWT_SECRET=your-super-secret-key-change-me

# ─── PostgreSQL connection pool ───
PG_POOL_MIN=2
PG_POOL_MAX=10

# ─── Optional: Path to SQLite workspace databases ───
# Default: ~/.deplao/data/

# ─── Optional: Media storage directory ───
# Default: ~/.deplao/media/

# ─── Logging ───
LOG_LEVEL=info

# ─── CORS origin (comma-separated) ───
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
