# ── Deplao Web Server — Multi-stage Docker build ──

# Stage 1: Build web SPA
FROM node:22-alpine AS web-builder
WORKDIR /app
COPY web/package*.json web/
RUN cd web && npm ci --legacy-peer-deps --ignore-scripts
COPY web/ web/
RUN cd web && npm run build

# Stage 2: Build backend
FROM node:22-alpine AS backend-builder
WORKDIR /app
RUN apk add --no-cache python3 make g++  # for native modules (better-sqlite3, sharp)
COPY package*.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts
COPY tsconfig.json ./
COPY src/ src/
RUN npx tsc

# Stage 3: Production image
FROM node:22-alpine
RUN apk add --no-cache tini ca-certificates ffmpeg

WORKDIR /app

# Backend compiled output
COPY --from=backend-builder /app/dist ./dist
COPY --from=backend-builder /app/node_modules ./node_modules
COPY package*.json ./

# Web SPA
COPY --from=web-builder /app/dist-web ./dist-web

# E2EE bridge binary for Facebook
COPY src/bridge-e2ee/build/ src/bridge-e2ee/build/

# Startup scripts
COPY scripts/ scripts/

ENV NODE_ENV=production
EXPOSE 8080

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
