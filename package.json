    "better-sqlite3": "^12.9.0",
    "bytenode": "^1.5.7",
    "cloudflared": "^0.7.1",
    "dompurify": "^3.4.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^171.4.0",
    "gramjs": "^0.8.4",
    "https-proxy-agent": "^9.0.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "localtunnel": "^2.0.2",
