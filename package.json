{
  "name": "Deplao",
  "version": "26.7.1",
  "description": "Web server quản lý Zalo & Facebook đa tài khoản tích hợp CRM, ERP, Workflow và AI Assistant",
  "type": "commonjs",
  "scripts": {
    "build:bridge-e2ee": "node scripts/build-bridge-e2ee.js",
    "build:web": "cd web && npm ci --legacy-peer-deps && npm run build",
    "db:seed": "node scripts/seed-admin.js",
    "build": "tsc && npm run build:web",
    "start": "node dist/server.js",
    "start:dev": "npx tsx src/server.ts",
    "test": "npx jest",
    "test:web": "npx jest --testPathPattern 'WebServer.test' --verbose",
    "test:e2e": "npx jest --testPathPattern 'E2E' --verbose"
  },
  "author": "babyvibe <babyvibe@users.noreply.github.com>",
  "license": "MIT",
